# Copy this file to .env.local for local development and fill in real values.
# In production (Vercel), you'll set these same names under
# Project Settings -> Environment Variables instead of using this file.

# Your Neon Postgres connection string.
# Get it from the Neon dashboard: Project -> Connection Details -> "Pooled connection".
# It looks like: postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A 4-8 digit PIN you choose yourself, used to lock your dashboard so strangers
# who guess the URL can't see your personal data.
DASHBOARD_PIN=1234

# A long random string used to sign your login session. Any random text works -
# you'll generate one during setup and never need to remember it.
SESSION_SECRET=change-me-to-a-long-random-string

# Your Resend API key, for sending the morning digest email.
# Get it from resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=

# The email address the morning digest gets sent to (your own inbox).
DIGEST_EMAIL=

# A long random string that protects the /api/cron/* endpoints from
# being triggered by anyone but Vercel's own scheduler.
# Any random text works - generate one during setup, same as SESSION_SECRET.
CRON_SECRET=change-me-to-a-different-long-random-string

# Twilio credentials, for the SMS morning nudge and overdue-item alerts.
# Get these from the Twilio Console dashboard (Account SID and Auth Token
# are shown right on the homepage after you sign in).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The phone number you bought in Twilio, in E.164 format (e.g. +15551234567).
TWILIO_FROM_NUMBER=

# Your own cell phone number, in the same E.164 format - this is where
# the text alerts get sent.
ALERT_PHONE_NUMBER=

# Your Anthropic API key, which powers the Assistant tab and the Becoming
# coach. Get it from console.anthropic.com -> API Keys -> Create Key.
# Without this, both features show a friendly "not set up yet" message
# instead of replying.
ANTHROPIC_API_KEY=

# Your Unsplash API access key, which powers the Daily Theme hero photos.
# Get it free from unsplash.com/developers -> Your apps -> New Application
# (Demo tier is plenty - see the README for the full walkthrough).
# Without this, Daily Theme still works fully, just without a photo.
UNSPLASH_ACCESS_KEY=
